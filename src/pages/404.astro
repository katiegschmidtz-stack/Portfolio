---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="section-title">This page doesn't exist (yet).</h1>
      <p class="lead">It may have moved, or the link might be wrong.</p>
      <a class="btn btn-sun" href="/">Go to the home page</a>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    color: var(--coral-deep);
  }
  .lead {
    margin-bottom: 2rem;
  }
</style>
