---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="About" description="About me: product leader across ecommerce, B2B commerce and enterprise AI.">
  <section class="about-hero on-dark" aria-labelledby="about-title">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1 id="about-title">Hi, I'm {site.name}.</h1>
      <p class="intro">
        Product leader with 10+ years across consumer ecommerce, B2B commerce and enterprise AI.
      </p>
    </div>
  </section>

  <div class="wrap about-body">
    <div class="photo">
      <!-- To add your photo: put it in the public folder (e.g. public/me.jpg), then replace
           this whole <div class="photo-placeholder"> with:
           <img src="/me.jpg" alt="Describe the photo, e.g. Your Name smiling outdoors" width="600" height="600" /> -->
      <div class="photo-placeholder" role="img" aria-label="Photo placeholder">
        <span>Photo coming soon</span>
      </div>
    </div>

    <div class="prose">
      <h2>My story</h2>
      <blockquote>
        <p>
          <strong>Placeholder.</strong> In two or three short paragraphs, share how you got into product,
          the kinds of problems you love, and what connects your ecommerce, B2B and AI work.
        </p>
      </blockquote>

      <h2>How I work</h2>
      <blockquote>
        <p>
          <strong>Placeholder.</strong> Describe your product approach in a few points. For example: how you
          work with engineering and design, how you decide what to build, and how you keep human judgment
          at the centre of AI products.
        </p>
      </blockquote>

      <h2>What I'm looking for</h2>
      <blockquote>
        <p>
          <strong>Placeholder.</strong> Describe the Product Lead, Staff, Principal or Senior PM roles you're
          interested in, and the kinds of teams and problems you want to take on next.
        </p>
      </blockquote>

      <h2>Outside of work</h2>
      <blockquote>
        <p>
          <strong>Placeholder.</strong> Optional: one or two lines about what you enjoy outside of work.
        </p>
      </blockquote>

      <div class="actions">
        <a class="btn btn-sun" href={site.resume} download>
          Download resume <span class="visually-hidden">(PDF)</span>
        </a>
        <a class="btn" href="/#contact">Get in touch</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-hero {
    background: var(--teal);
    color: #fff;
    border-bottom: var(--border);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .eyebrow {
    color: #fff;
  }

  h1 {
    font-size: clamp(2.75rem, 8vw, 5rem);
  }

  .intro {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    max-width: 40rem;
    margin: 0;
  }

  .about-body {
    display: grid;
    gap: 3rem;
    padding-block: clamp(3rem, 7vw, 5rem) var(--section);
  }

  .photo-placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-width: min(16rem, 100%);
    background: var(--sun);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: 8px 8px 0 var(--violet);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
  }

  .photo :global(img) {
    max-width: 16rem;
    width: 100%;
    height: auto;
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: 8px 8px 0 var(--violet);
  }

  @media (min-width: 56rem) {
    .about-body {
      grid-template-columns: 20rem 1fr;
      gap: 4rem;
    }
    .photo-placeholder,
    .photo :global(img) {
      max-width: 22rem;
    }
    .photo {
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
  }

  .prose {
    max-width: 44rem;
  }

  h2 {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin-top: 2.5rem;
  }

  h2:first-child {
    margin-top: 0;
  }

  blockquote {
    margin: 1rem 0;
    padding: 1.25rem 1.5rem;
    background: var(--teal-tint);
    border: 2px dashed var(--teal);
    border-radius: var(--radius-sm);
  }

  blockquote p {
    margin: 0;
  }

  blockquote strong {
    display: inline-block;
    background: var(--teal);
    color: #fff;
    padding: 0 0.5rem;
    border-radius: 0.3rem;
    margin-right: 0.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
  }
</style>
