---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="wrap footer-inner">
    <p>© {year} {site.name}</p>
    <ul>
      <li><a href={`mailto:${site.email}`}>Email</a></li>
      <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
      <li><a href={site.resume} download>Resume (PDF)</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #fff;
    padding-block: 2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--lilac);
    display: inline-block;
    padding-block: 0.4rem;
  }
</style>
